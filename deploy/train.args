--encoder flat --critic-encoder entity --actor-encoder entity --actor-hidden 768,768,384 --card-dim 128 --scenario-pool --pool-frac 0.6 --warmup-games 16 --ent-start 0.010 --ent-end 0.008 --ent-anneal-iters 250000 --scenario-weight board_presence=0.5 --scenario-weight deckout=0.5 --scenario-boost 5 --games-per-iter 32 --minibatch 1024 --belief bookkeeper --critic-view public --critic-deckout-aux 0.1 --text-change guided --freeze-actor-iters 1500 --kl-teacher-coef 0.1 --kl-teacher-iters 30000