[Unit]
Description=fishrl LAN telemetry server (range API + SSE over stats.json/ticks.json)
After=network-online.target
Wants=network-online.target

[Service]
User=zubekanov
Group=zubekanov
WorkingDirectory=/home/zubekanov/Repositories/How-To-Train-Your-Fish
Environment=PYTHONUNBUFFERED=1
# Sibling of the trainer: never locks or writes the training files, so it can
# restart freely and keeps serving across trainer restarts / relay handoffs.
# --allow-actions mounts the dashboard's stop/start/eval buttons (POST-only,
# state-validated; systemctl via `sudo -n`, so the zubekanov NOPASSWD rule the
# relay already uses must cover systemctl). Drop the flag for strictly read-only.
ExecStart=/home/zubekanov/Repositories/Website_Dev/.venv/bin/python -m fishrl.serve \
  --ckpt-dir /home/zubekanov/Repositories/How-To-Train-Your-Fish/checkpoints --port 8765 \
  --allow-actions
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
